# Copy to .env and point at any OpenAI-compatible /chat/completions endpoint.
# Real environment variables always win over this file.

# LM Studio (default)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-3-12b
LLM_API_KEY=lm-studio

# Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-3-27b-it
# LLM_API_KEY=sk-or-...

# AgentPhone signs every webhook with this secret; `uv run serve` refuses
# all webhooks (401) until it is set. Copy it from the AgentPhone dashboard.
AGENTPHONE_WEBHOOK_SECRET=

# Outbound calls (`uv run dialer --confirm`). Leave these empty and only
# `uv run dialer --dry-run` works, which never dials anyone.
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_FROM_NUMBER_ID=

# Postgres. This default is the local database that `supabase start` runs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Tests use their own database, never the one above. Default: the same server with
# the database name `debtagentcall_test`. If you set this, the name must end in `_test`.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/debtagentcall_test

# Owner's own phone only: numbers (E.164, comma-separated) that skip the calling-hours
# and call-limit (7-in-7) rules so you can test real calls at any time. Every other
# check still applies, and every attempt is still recorded.
# TEST_NUMBERS=+15555550123

# The operator chat's time zone when the browser sends none ("paid yesterday" is read in it).
# OPERATOR_TZ=America/New_York
