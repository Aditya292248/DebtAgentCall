# Local Supabase only (`npx supabase start`, then `npx supabase status`).
# This is the well-known local-dev anon key, not a secret; never put a hosted
# project's keys here. Copy to web/.env.local, which git ignores.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-from-supabase-status
